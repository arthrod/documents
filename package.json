{
  "name": "plate-js-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/server/index.tsx",
    "start": "bun run src/server/index.tsx",
    "lint": "eslint .",
    "postinstall": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.864.0",
    "@aws-sdk/s3-presigned-post": "^3.864.0",
    "@aws-sdk/s3-request-presigner": "3.864.0",
    "@aws-sdk/types": "^3.862.0",
    "@elysiajs/cors": "^1.3.3",
    "@elysiajs/eden": "^1.3.2",
    "@elysiajs/html": "^1.3.1",
    "@elysiajs/trpc": "^1.1.0",
    "@prisma/client": "6.13.0",
    "@socket.io/admin-ui": "^0.5.1",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.54.0",
    "@trpc/client": "^11.4.4",
    "@trpc/server": "^11.4.4",
    "elysia": "^1.3.8",
    "prisma": "^6.13.0",
    "rfc6902": "^5.1.2",
    "socket.io": "^4.8.1",
    "source-map-support": "^0.5.21",
    "superjson": "^2.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "ws": "^8.18.3",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/node": "24.2.1",
    "@types/socket.io": "3.0.2",
    "@types/source-map-support": "^0.5.10",
    "@types/ws": "^8.18.1",
    "@kitajs/ts-html-plugin": "^4.1.2",
    "eslint": "^9.33.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
